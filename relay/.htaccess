# Centiwise Relay — Apache configuration

Options -Indexes

# Deny direct access to config.php
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# Rewrite all requests to index.php, preserving PATH_INFO
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php/$1 [L,QSA]
