# ── Database ──────────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=https://andiza.co.rw

# ── Site URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://andiza.co.rw

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key
SMTP_HOST=mail.andiza.co.rw
SMTP_PORT=465
SMTP_USER=noreply@andiza.co.rw
SMTP_PASSWORD=your_smtp_password

# ── Centiwise Payment Gateway ─────────────────────────────────────────────────
# Credentials from Centiwise (Alain / Godwin)
CENTIWISE_LOGIN=Andiza_cw
CENTIWISE_CONTROL_KEY=your_control_key
CENTIWISE_ENDPOINT_ID=108048
# Where Centiwise POSTs payment status updates
CENTIWISE_CALLBACK_URL=https://andiza.co.rw/api/subscriptions/centiwise/callback

# ── Fixed-IP PHP Relay ────────────────────────────────────────────────────────
# Relay runs on cPanel (197.243.23.16) and forwards requests to Centiwise.
# This ensures Centiwise always sees a whitelisted IP instead of Vercel's rotating IPs.
# See RELAY_SETUP.md for full setup instructions.
RELAY_BASE_URL=https://relay.andiza.co.rw
# Generate with: openssl rand -hex 32
# Must match RELAY_SECRET in relay/config.php on the server
RELAY_SECRET=your_relay_secret_min_32_chars

# ── Site Verification ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification
NEXT_PUBLIC_YANDEX_VERIFICATION=your_yandex_verification
